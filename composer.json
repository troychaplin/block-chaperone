{
	"name": "troychaplin/blockpolicy",
	"description": "BlockPolicy – Restrict Blocks by Role & Post Type.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"autoload": {
		"classmap": [
			"classes/"
		]
	},
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.4.1"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"format": "phpcbf",
		"lint": "phpcs"
	}
}
