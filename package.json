{
	"name": "block-chaperone",
	"version": "0.1.0",
	"description": "Block Chaperone – Restrict Blocks by Role & Post Type.",
	"author": "Troy Chaplin",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"lint": "npm run lint:js && npm run lint:php && npm run lint:css",
		"format": "npm run format:js && npm run format:php && npm run format:css",
		"lint:js": "wp-scripts lint-js --max-warnings=0",
		"format:js": "wp-scripts lint-js --fix",
		"lint:css": "stylelint \"**/*.scss\" --max-warnings=0",
		"format:css": "stylelint \"**/*.scss\" --fix",
		"lint:php": "composer run lint",
		"format:php": "composer format",
		"clean": "rm -rf node_modules ; rm package-lock.json ; npm install",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts build && wp-scripts plugin-zip",
		"prepare": "husky"
	},
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@wordpress/api-fetch": "^8.1.0",
		"@wordpress/block-editor": "^20.1.0",
		"@wordpress/blocks": "^17.2.0",
		"@wordpress/components": "^44.0.0",
		"@wordpress/compose": "^9.2.0",
		"@wordpress/data": "^11.2.0",
		"@wordpress/dataviews": "^22.0.0",
		"@wordpress/dom-ready": "^5.2.0",
		"@wordpress/element": "10.1.0",
		"@wordpress/env": "12.1.0",
		"@wordpress/eslint-plugin": "28.1.0",
		"@wordpress/hooks": "^5.2.0",
		"@wordpress/i18n": "7.1.0",
		"@wordpress/icons": "^20.0.0",
		"@wordpress/prettier-config": "5.1.0",
		"@wordpress/scripts": "37.1.0",
		"@wordpress/stylelint-config": "27.1.0",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"husky": "^9.1.7",
		"stylelint": "17.16.0",
		"stylelint-scss": "7.5.0",
		"typescript": "^6.0.2"
	}
}
